<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Noexs.UI.Controls"
             x:Class="Noexs.UI.NoexsApplication"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <!-- app-specific colours; everything else comes from the Simple theme's Light/Dark variants -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NoexsPaneBackground" Color="#FFF4F4F4" />
                    <SolidColorBrush x:Key="NoexsPaneHeader" Color="#FFE0E0E0" />
                    <SolidColorBrush x:Key="NoexsPaneBorder" Color="#FFB5B5B5" />
                    <SolidColorBrush x:Key="NoexsGridRow" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="NoexsGridLines" Color="#FFD0D0D0" />
                    <SolidColorBrush x:Key="NoexsProgressTrack" Color="#FFE4E4E4" />
                    <SolidColorBrush x:Key="NoexsProgressBar" Color="#FF4A8FDB" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="NoexsPaneBackground" Color="#FF2B2B2B" />
                    <SolidColorBrush x:Key="NoexsPaneHeader" Color="#FF383838" />
                    <SolidColorBrush x:Key="NoexsPaneBorder" Color="#FF4F4F4F" />
                    <SolidColorBrush x:Key="NoexsGridRow" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="NoexsGridLines" Color="#FF3C3C3C" />
                    <SolidColorBrush x:Key="NoexsProgressTrack" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="NoexsProgressBar" Color="#FF3C7DC4" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <SimpleTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml" />

        <!-- The FXML coordinates were laid out for a proportional font, so labels use the system
             font and Droid Sans Mono (fonts/droid-sans-mono.css) is used for data and hex input. -->
        <Style Selector=":is(TopLevel)">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="DataGrid, ListBox, TreeView, TextBox">
            <Setter Property="FontFamily" Value="avares://noexs/Assets/Fonts#Droid Sans Mono" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <!-- always-editable grid cells: one click and type; Enter or leaving the cell commits -->
        <Style Selector="TextBox.cell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.cell:focus">
            <Setter Property="Background" Value="{DynamicResource NoexsGridRow}" />
        </Style>

        <Style Selector="Separator">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="RowBackground" Value="{DynamicResource NoexsGridRow}" />
            <Setter Property="Background" Value="{DynamicResource NoexsGridRow}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource NoexsGridLines}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource NoexsGridLines}" />
        </Style>
        <Style Selector="ListBox, TreeView">
            <Setter Property="Background" Value="{DynamicResource NoexsGridRow}" />
        </Style>

        <!-- keep the tab strip about as tall as JavaFX's so the 470px pages fit -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource NoexsProgressTrack}" />
            <Setter Property="Foreground" Value="{DynamicResource NoexsProgressBar}" />
        </Style>

        <!-- views/css/styles.css: .table-cell { -fx-alignment: CENTER; } -->
        <Style Selector="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="c|TitledPane">
            <Setter Property="Template">
                <ControlTemplate TargetType="c:TitledPane">
                    <Border BorderBrush="{DynamicResource NoexsPaneBorder}" BorderThickness="1"
                            Background="{DynamicResource NoexsPaneBackground}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource NoexsPaneHeader}"
                                    BorderBrush="{DynamicResource NoexsPaneBorder}"
                                    BorderThickness="0,0,0,1" Padding="8,4">
                                <ContentPresenter Content="{TemplateBinding Header}" />
                            </Border>
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="c|TitledPane:disabled">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
    </Application.Styles>
</Application>
