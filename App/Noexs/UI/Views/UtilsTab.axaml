<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Noexs.UI.Controls"
             x:Class="Noexs.UI.Views.UtilsTab"
             Width="1022" Height="470">
    <Canvas>
        <c:TitledPane Canvas.Left="14" Canvas.Top="14" Width="542" Height="447" Header="USB Utils">
            <Canvas>
                <TreeView x:Name="deviceTree" Canvas.Left="14" Canvas.Top="31" Width="509" Height="200"
                          BorderBrush="{DynamicResource NoexsPaneBorder}" BorderThickness="1" />
                <TextBlock Canvas.Left="14" Canvas.Top="14" Text="Connected Devices:" />
                <Button Canvas.Left="15" Canvas.Top="273" Width="508" Height="25" Content="Refresh" Click="OnRefresh" />
                <TextBlock Canvas.Left="15" Canvas.Top="243" Text="Device Info:" />
                <TextBlock x:Name="infoLabel" Canvas.Left="84" Canvas.Top="243" />
            </Canvas>
        </c:TitledPane>
        <c:TitledPane x:Name="logPane" Canvas.Left="566" Canvas.Top="14" Width="442" Height="447" Header="Switch Log" IsEnabled="False">
            <Canvas>
                <TextBlock Canvas.Left="14" Canvas.Top="12" Width="300" TextWrapping="Wrap" FontSize="12"
                           Text="Recent messages of the noexs sysmodule (USB setup, network, ...), also when it can't write to the SD card." />
                <Button Canvas.Left="320" Canvas.Top="12" Width="104" Height="25" Content="Refresh"
                        HorizontalContentAlignment="Center" Click="OnRefreshLog" />
                <TextBox x:Name="logText" Canvas.Left="14" Canvas.Top="50" Width="410" Height="320" IsReadOnly="True"
                         TextWrapping="NoWrap" AcceptsReturn="True" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Button Canvas.Left="14" Canvas.Top="378" Width="140" Height="25" Content="Copy Log"
                        HorizontalContentAlignment="Center" Click="OnCopyLog" />
            </Canvas>
        </c:TitledPane>
    </Canvas>
</UserControl>
